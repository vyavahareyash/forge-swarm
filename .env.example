# Slack Socket Mode App-Level Token (Starts with xapp-) with connections:write scope
SLACK_APP_TOKEN=xapp-1-...

# Slack Bot User OAuth Token (Starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-...

# Target Slack Channel ID (e.g. C0123456789 for #agent-ops)
SLACK_CHANNEL_ID=C0123456789

# Optional Slack User ID to @mention on approvals/gates (e.g. U0C9R6Y2LHY)
SLACK_USER_ID=U0C9R6Y2LHY
