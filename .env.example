# Slack Socket Mode App-Level Token (Starts with xapp-) with connections:write scope
SLACK_APP_TOKEN=xapp-1-...

# Slack Bot User OAuth Token (Starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-...

# Target Slack Channel ID (e.g. C0123456789 for #agent-ops)
SLACK_CHANNEL_ID=C0123456789

# Optional Slack User ID to @mention on approvals/gates (e.g. U0C9R6Y2LHY)
SLACK_USER_ID=U0C9R6Y2LHY

# Target repository path on local filesystem for worktree isolation
TARGET_REPO_PATH=/Users/yash/Documents/Repos/sample-calc-repo

# GitHub repository in owner/repo format for gh CLI issue and PR management
GITHUB_REPO=vyavahareyash/sample-calc-repo

# Path to Antigravity CLI binary for headless execution (agy -p)
AGY_PATH=/Users/yash/.local/bin/agy

# GitHub Personal Access Token for gh CLI authentication (optional if already authenticated via `gh auth login`)
GH_TOKEN=ghp_...
GITHUB_TOKEN=ghp_...
